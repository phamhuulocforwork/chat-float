{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 3,
  "version": "1.0.2",
  "version_name": "1.0.2",
  "firefox:browser_specific_settings": {
    "gecko": {
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "name": "Chat Float",
  "short_name": "Chat Float",
  "description": "Float YouTube live chat messages over videos as a customizable danmaku overlay.",
  "homepage_url": "https://github.com/phamhuulocforwork/chat-float",
  "icons": {
    "16": "images/icon.png",
    "32": "images/icon.png",
    "48": "images/icon.png",
    "64": "images/icon.png",
    "128": "images/icon.png"
  },
  "chromium:action": {
    "default_icon": {
      "16": "images/icon.png",
      "32": "images/icon.png",
      "48": "images/icon.png",
      "64": "images/icon.png",
      "128": "images/icon.png"
    },
    "default_popup": "action/index.html",
    "default_title": "Chat Float settings"
  },
  "firefox:browser_action": {
    "default_icon": {
      "16": "images/icon.png",
      "32": "images/icon.png",
      "48": "images/icon.png",
      "64": "images/icon.png",
      "128": "images/icon.png"
    },
    "default_popup": "action/index.html",
    "default_title": "Chat Float settings"
  },
  "chromium:side_panel": {
    "default_path": "sidebar/index.html",
    "default_title": "Chat Float"
  },
  "firefox:sidebar_action": {
    "default_panel": "sidebar/index.html",
    "default_title": "Chat Float"
  },
  "chromium:permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "firefox:permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "chromium:optional_host_permissions": [
    "<all_urls>"
  ],
  "firefox:optional_host_permissions": [
    "<all_urls>"
  ],
  "chromium:web_accessible_resources": [
    {
      "resources": [
        "popup-blocker/inject/main.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "firefox:web_accessible_resources": [
    {
      "resources": [
        "popup-blocker/inject/main.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": [
      "background.ts"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content/scripts.tsx"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*/*"
      ],
      "exclude_matches": [
        "*://*/*"
      ],
      "js": [
        "popup-blocker/inject/isolated.tsx"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
